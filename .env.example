# Backend API — phải là HTTPS public khi build EAS (simulator/Appetize chạy trên cloud,
# không truy cập được localhost hay IP LAN của máy bạn)
EXPO_PUBLIC_API_BASE_URL=https://smartmoney-haibang.duckdns.org

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth — Web client ID, quyết định `aud` của idToken gửi cho backend
EXPO_PUBLIC_SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=

# Google OAuth — iOS client ID (Google Cloud Console > Credentials > OAuth client ID
# > loại iOS, bundle ID = com.smartmoneyfrontend). Bắt buộc cho iOS.
# app.config.js tự suy ra REVERSED_CLIENT_ID (iosUrlScheme) từ giá trị này.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com

# Facebook
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Cloudinary
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
